# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role key - server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the cron route requires in `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend (resend.com) - sends price alert confirmation emails.
# Requires thaigoldtracker.com to be verified as a sending domain in Resend.
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=https://thaigoldtracker.com

# Web Push (browser notifications). One VAPID key pair for the whole project:
#   - NEXT_PUBLIC_VAPID_PUBLIC_KEY: also set in Vercel (Production + Preview).
#   - VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: also set as Supabase Edge Function
#     secrets (`supabase secrets set`), used by fetch-prices and push-test.
# The two public values are the same string. Never regenerate the pair once
# real users have subscribed - every browser subscription is bound to it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# IndexNow key (indexnow.org): 8-128 characters from a-z, A-Z, 0-9 and "-".
# Also set in Vercel (Production). The site serves it at /<key>.txt; it is
# deliberately not committed, because the repo is public.
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=
