# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role key - server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the cron route requires in `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend (resend.com) - sends price alert confirmation emails.
# Requires thaigoldtracker.com to be verified as a sending domain in Resend.
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=https://thaigoldtracker.com
